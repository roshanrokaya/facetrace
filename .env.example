# Database
DATABASE_URL=postgresql+psycopg://facetrace:facetrace_password@localhost:5432/facetrace

# Backend Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Face Recognition
FACE_RECOGNITION_THRESHOLD=0.45
FACE_DETECTION_MIN_SIZE=60
FACE_QUALITY_THRESHOLD=100.0
COOLDOWN_SECONDS=60

# Retention
SNAPSHOT_RETENTION_DAYS=30
UNKNOWN_FACE_RETENTION_DAYS=7

# Working Hours
WORKING_HOUR_START=09:00
WORKING_HOUR_END=17:00

# Storage
STORAGE_PATH=./storage
SNAPSHOT_PATH=./storage/snapshots
ENROLLMENT_PATH=./storage/enrollments

# Alerts
LOW_ATTENDANCE_THRESHOLD=0.75
UNUSUAL_TIME_Z_SCORE=2.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
